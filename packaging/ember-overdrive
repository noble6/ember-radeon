#!/bin/bash
# Enable/disable amdgpu overdrive (clock & voltage control) via ppfeaturemask.
# Run as root. Takes effect after a reboot.
set -euo pipefail
CONF=/etc/modprobe.d/ember-overdrive.conf
OD_BIT=$((0x4000))

[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }

current=$(cat /sys/module/amdgpu/parameters/ppfeaturemask 2>/dev/null || echo 0xfff7bfff)
case "${1:-status}" in
  enable)
    if grep -qo 'amdgpu.ppfeaturemask=[^ ]*' /proc/cmdline; then
      echo "amdgpu.ppfeaturemask is set on the kernel command line, which overrides modprobe.d. Edit your bootloader entry instead." >&2
      exit 2
    fi
    new=$(printf '0x%08x' $(( current | OD_BIT )))
    printf '# Written by Ember: unlocks amdgpu overdrive (OD) controls.\noptions amdgpu ppfeaturemask=%s\n' "$new" > "$CONF"
    echo "wrote $CONF ($new)"
    ;;
  disable)
    rm -f "$CONF"
    echo "removed $CONF"
    ;;
  status)
    printf 'current ppfeaturemask %s, overdrive %s\n' "$current" $(( current & OD_BIT ? 1 : 0 ))
    [[ -f $CONF ]] && cat "$CONF"
    exit 0
    ;;
  *) echo "usage: $0 enable|disable|status" >&2; exit 64 ;;
esac

# amdgpu usually loads from the initramfs (kms hook), so it must see the new option there too.
if command -v mkinitcpio >/dev/null; then
  mkinitcpio -P
elif command -v dracut >/dev/null; then
  dracut --regenerate-all -f
elif command -v update-initramfs >/dev/null; then
  update-initramfs -u -k all
fi
echo "done, reboot to apply"
