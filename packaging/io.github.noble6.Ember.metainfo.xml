<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.noble6.Ember</id>
  <name>Ember</name>
  <summary>AMD Radeon control center: tuning, fan curves, FSR 4, FreeSync</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.noble6"><name>noble6</name></developer>
  <description>
    <p>Ember is an Adrenalin-style GPU control center for AMD Radeon graphics on Linux.
    Monitor clocks, temperatures and power; overclock and undervolt; draw fan curves; switch
    profiles automatically per game; record gameplay and save Instant Replays with hotkeys; and enable FSR 4, Anti-Lag, sharpening, Super Resolution,
    FreeSync and HDR from one place.</p>
    <p>Supports RDNA 4, RDNA 3, RDNA 2, RDNA 1, Vega, Polaris and Ryzen APUs on the amdgpu driver.</p>
  </description>
  <launchable type="desktop-id">ember.desktop</launchable>
  <url type="homepage">https://github.com/noble6/ember-radeon</url>
  <url type="bugtracker">https://github.com/noble6/ember-radeon/issues</url>
